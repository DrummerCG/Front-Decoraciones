{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch React App with Yarn",
            "program": "${workspaceFolder}/node_modules/react-scripts/scripts/start.js",
            "cwd": "${workspaceFolder}/front-decoraciones",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "start"
            ],
            "console": "integratedTerminal"
        }
    ]
}